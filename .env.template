# ---------------------------------------------------------------------------
# This template contains only required options.
# Visit the docs to find more https://docs.tandoor.dev/system/configuration/
# ---------------------------------------------------------------------------

# random secret key, use for example `base64 /dev/urandom | head -c50` to generate one
SECRET_KEY=

# id of the space ALL users share (required, startup fails and lists existing spaces if unset)
# every user is forced into this space, other spaces are handed to inactive placeholder users
# on a fresh install use 1, the space is created for the first user
SINGLE_TENANT_ID=1

# optional: disable invite links and local signup, users can then only come from LDAP / social login
# YOU_ARE_NOT_INVITING_ANYONE_EVER=true

# your default timezone See https://timezonedb.com/time-zones for a list of timezones
TZ=Europe/Berlin

# allowed hosts (see documentation), must be set to your hostname(s)
ALLOWED_HOSTS=recipes.mydomain.com

# add only a database password if you want to run with the default postgres, otherwise change settings accordingly
DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=db_recipes
POSTGRES_DB=djangodb
POSTGRES_PORT=5432
POSTGRES_USER=djangouser
POSTGRES_PASSWORD=
